/* hash_map - MSVC's pre-standard container, which STLTypedefs.h aliases onto unordered_map.
** Providing the header keeps PreRTS.h's include list intact. */
#ifndef WIN32COMPAT_SHIM_HASH_MAP
#define WIN32COMPAT_SHIM_HASH_MAP
#include <unordered_map>
namespace stdext {
	using std::unordered_map;
	template<class K, class V, class H = std::hash<K>, class E = std::equal_to<K>>
	using hash_map = std::unordered_map<K, V, H, E>;
}
#endif
